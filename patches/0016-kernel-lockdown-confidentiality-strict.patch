From: HackerOS Linux System <hackeros068@gmail.com>
Subject: [PATCH 16/16] hackeros: audyt prob zmiany poziomu lockdown przez securityfs

Dodaje audit hook w lockdown_write() logujacy KAZDA probe zmiany
poziomu lockdown przez /sys/kernel/security/lockdown, niezaleznie
od wyniku. Upstream juz blokuje obniznie poziomu (lock_kernel_down
sprawdza kernel_locked_down >= level), ale nie loguje prby samej
w sobie. Nieudana proba obnizenia poziomu lockdown (np. z
"confidentiality" na "none") na systemie zabezpieczonym jest
silnym sygnalem ataku (napastnik z root - proba wyaczenia
hardeningu). Komenda, PID i comm sa logowane przez:
  hackeros_lockdown_audit: REJECTED lockdown change to 'X' pid=... comm=...
  hackeros_lockdown_audit: lockdown changed to 'X' pid=... comm=...

---
 security/lockdown/lockdown.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

--- a/security/lockdown/lockdown.c
+++ b/security/lockdown/lockdown.c
@@ -15,6 +15,11 @@
 #include <linux/lsm_hooks.h>
 #include <uapi/linux/lsm.h>
 
+#ifdef CONFIG_HACKEROS_KERNEL
+#include <linux/sched.h>
+static void hackeros_lockdown_change_audit_log(const char *requested_state, int err);
+#endif
+
 static enum lockdown_reason kernel_locked_down;
 
 static const enum lockdown_reason lockdown_levels[] = {LOCKDOWN_NONE,
@@ -143,10 +148,36 @@
 			err = lock_kernel_down("securityfs", level);
 	}
 
+#ifdef CONFIG_HACKEROS_KERNEL
+	hackeros_lockdown_change_audit_log(state, err);
+#endif
+
 	kfree(state);
 	return err ? err : n;
 }
 
+#ifdef CONFIG_HACKEROS_KERNEL
+/*
+ * HackerOS Cybersecurity: audyt KAZDEJ proby zmiany poziomu lockdown
+ * przez securityfs (/sys/kernel/security/lockdown), niezaleznie czy
+ * sie powiodla. lock_kernel_down() juz chroni przed obnizeniem poziomu
+ * (kernel_locked_down >= level -> -EPERM), ale nieudana proba OBNIZENIA
+ * poziomu jest sama w sobie silnym sygnalem - oznacza, ze proces z
+ * uprawnieniami do securityfs aktywnie probowal zmniejszyc hardening,
+ * co na stacji cybersecurity (HackerOS) zasluguje na widoczny slad
+ * audytowy z PID i nazwa procesu inicjujacego.
+ */
+static void hackeros_lockdown_change_audit_log(const char *requested_state, int err)
+{
+	if (err)
+		pr_warn("hackeros_lockdown_audit: REJECTED lockdown change to '%s' pid=%d comm=%s err=%d\n",
+			requested_state, current->pid, current->comm, err);
+	else
+		pr_notice("hackeros_lockdown_audit: lockdown changed to '%s' pid=%d comm=%s\n",
+			  requested_state, current->pid, current->comm);
+}
+#endif
+
 static const struct file_operations lockdown_ops = {
 	.read  = lockdown_read,
 	.write = lockdown_write,
-- 
