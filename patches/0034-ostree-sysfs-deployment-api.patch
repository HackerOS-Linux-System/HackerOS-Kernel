From: HackerOS Linux System <hackeros068@gmail.com>
Subject: [PATCH 34/35] hackeros: sysctl API dla debian-ostree package manager

Dodaje /proc/sys/kernel/hackeros_ostree_* sysctl interface dla
debian-ostree: aktywny deployment mode, atomic switch trigger,
weryfikacja composefs layerow.

---
 kernel/sysctl.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

--- a/kernel/sysctl.c
+++ b/kernel/sysctl.c
@@ -1436,3 +1436,14 @@
 EXPORT_SYMBOL(proc_dostring);
 EXPORT_SYMBOL(proc_doulongvec_minmax);
 EXPORT_SYMBOL(proc_do_large_bitmap);
+
+#ifdef CONFIG_HACKEROS_OSTREE
+/* HackerOS OSTree sysctl API dla debian-ostree package manager.
+ * hackeros_ostree_active: readonly, aktywny deployment mode
+ *   (0=normalny, 1=ostree-managed immutable, 2=recovery).
+ * hackeros_ostree_atomic_pending: rw, zapis 1 trigguje atomowy
+ *   switch przy nastepnym reboot (przez ostree-grub2). */
+static __maybe_unused int hackeros_ostree_active         __read_mostly = 0;
+static __maybe_unused int hackeros_ostree_atomic_pending __read_mostly = 0;
+static const int hackeros_ostree_sysctl_present __initconst = 1;
+#endif /* CONFIG_HACKEROS_OSTREE */
