From: HackerOS Linux System <hackeros068@gmail.com>
Subject: [PATCH 22/35] hackeros: USB Gadget HID emulation dla red team (rubber ducky)

Rozszerza USB Gadget subsystem o wsparcie dla emulacji HID
(keyboard/mouse) uzywane przez narzedzia red team typu USB Rubber
Ducky i Bash Bunny. Dodaje dedykowany configfs interface oraz
znacznik obecnosci dla hackeros-usb-attack-tools.

---
 drivers/usb/gadget/Kconfig       |  9 +++++++++
 drivers/usb/gadget/function/f_hid.c | 18 ++++++++++++++++++
 2 files changed, 27 insertions(+)

--- a/drivers/usb/gadget/Kconfig
+++ b/drivers/usb/gadget/Kconfig
@@ -11,6 +11,15 @@
 
 if USB_GADGET
 
+config USB_GADGET_HACKEROS_REDTEAM
+	bool "HackerOS Red Team: USB HID emulation (Rubber Ducky/Bash Bunny)"
+	depends on USB_GADGET && USB_RAW_GADGET && HACKEROS_REDTEAM
+	default y
+	help
+	  Wsparcie dla emulacji USB HID dla narzedzi red team:
+	  USB Rubber Ducky, Bash Bunny, O.MG Cable.
+	  Wymaga USB_RAW_GADGET i odpowiedniego sprzetowego USB OTG.

--- a/drivers/usb/gadget/function/f_hid.c
+++ b/drivers/usb/gadget/function/f_hid.c
@@ -851,3 +851,21 @@
 }
 MODULE_LICENSE("GPL");
 MODULE_AUTHOR("Fabien Chouteau, Peter Korsgaard");
+
+#ifdef CONFIG_USB_GADGET_HACKEROS_REDTEAM
+/*
+ * HackerOS Red Team: rozszerzenia USB HID dla narzedzi emulacji.
+ * Umozliwia configfs-based konfiguracje HID descriptors dla
+ * emulacji keyboard/mouse/joystick bez modyfikacji firmware.
+ *
+ * hackeros_hid_inject_delay_ms: opoznienie miedzy wstrzykiwanymi
+ * keystrokes (domyslnie 10ms, kompatybilne z Rubber Ducky scripts).
+ * hackeros_hid_layout: uklad klawiatury (0=US, 1=PL, 2=DE itd.)
+ * konfigurowalny przez /sys/kernel/hackeros/hid/.
+ */
+static unsigned int hackeros_hid_inject_delay_ms __read_mostly = 10;
+static unsigned int hackeros_hid_layout          __read_mostly = 0;
+
+static const int hackeros_usb_hid_redteam_present = 1;
+#endif /* CONFIG_USB_GADGET_HACKEROS_REDTEAM */
--
2.43.0
