From: HackerOS Linux System <hackeros068@gmail.com>
Subject: [PATCH 21/35] hackeros: netfilter hooks dla red team MITM

Dodaje zmienne konfiguracyjne netfilter dla red team:
ARP spoofing passthrough i dedykowana kolejka NFQUEUE dla narzedzi
MITM (mitmproxy, bettercap, ettercap).

---
 net/netfilter/core.c | 9 +++++++++
 1 file changed, 9 insertions(+)

--- a/net/netfilter/core.c
+++ b/net/netfilter/core.c
@@ -825,3 +825,12 @@
 err:
 	return ret;
 }
+
+#ifdef CONFIG_HACKEROS_REDTEAM
+/* HackerOS Red Team: netfilter parametry dla narzedzi MITM.
+ * hackeros_nf_redteam_queue: dedykowana kolejka NFQUEUE (!=0 aktywuje).
+ * hackeros_nf_arp_passthrough: ARP bypass dla autoryzowanego lab (0=off). */
+static __maybe_unused int hackeros_nf_redteam_queue   __read_mostly = 0;
+static __maybe_unused int hackeros_nf_arp_passthrough __read_mostly = 0;
+static const int hackeros_netfilter_redteam_hooks __initconst = 1;
+#endif /* CONFIG_HACKEROS_REDTEAM */
