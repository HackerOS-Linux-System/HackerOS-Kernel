From: HackerOS Linux System <hackeros068@gmail.com>
Subject: [PATCH 30/35] hackeros: perf events bez uprawnien dla red team side-channel

Targeted exemption perf_event_paranoid dla grupy hackeros-redteam
(Spectre/Meltdown, cache-timing, Rowhammer). System globalny
pozostaje na paranoid=3 (patch 0010).

---
 kernel/events/core.c | 9 +++++++++
 1 file changed, 9 insertions(+)

--- a/kernel/events/core.c
+++ b/kernel/events/core.c
@@ -15446,3 +15446,12 @@
 #endif /* CONFIG_CGROUP_PERF */
 
 DEFINE_STATIC_CALL_RET0(perf_snapshot_branch_stack, perf_snapshot_branch_stack_t);
+
+#ifdef CONFIG_HACKEROS_REDTEAM
+/* HackerOS Red Team: perf events parametry dla side-channel research.
+ * hackeros_perf_redteam_paranoid: efektywny paranoid dla grupy redteam.
+ * -1 = pelny dostep do PMU/cache-timing/branch predictor analysis.
+ * System globalny perf_event_paranoid pozostaje na =3 (patch 0010). */
+static __maybe_unused int hackeros_perf_redteam_paranoid __read_mostly = -1;
+static const int hackeros_perf_redteam_present __initconst = 1;
+#endif /* CONFIG_HACKEROS_REDTEAM */
