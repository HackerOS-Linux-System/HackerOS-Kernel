! ===========================================================================
! HackerOS Kernel - config.hk
! Glowny plik konfiguracyjny build systemu jadra
! Format: .hk (https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/hk.html)
! ===========================================================================

[metadata]
-> name        => HackerOS Kernel
-> codename    => Wolfsbane
-> branch      => cybersecurity
-> maintainer  => HackerOS Linux System <hackeros068@gmail.com>
-> homepage    => https://hackeros-linux-system.github.io/HackerOS-Website/
-> license     => MPL-2.0
-> description => Zmodyfikowane jadro Linux dla HackerOS Cybersecurity Edition

! ---------------------------------------------------------------------------
! Zrodlo jadra (vanilla Linux). Build.lua sciaga ten tarball i nadpisuje go
! patchami z patches/. Domyslnie: 7.1 - skrypt sam wykrywa nowsze wersje
! z kernel.org, jesli "auto_latest" jest true.
! ---------------------------------------------------------------------------
[source]
-> base_version    => 7.1
-> auto_latest     => true
-> min_version     => 7.1
-> mirror          => https://cdn.kernel.org/pub/linux/kernel/v${source.major}.x/
-> major           => 7
-> tarball_pattern => linux-${source.base_version}.tar.xz
-> sha_check       => true

[target]
-> arch         => x86_64
-> distro       => debian
-> distro_base  => testing
-> format       => deb
-> bootloader   => grub2
-> init_systems => ["systemd"]

! ---------------------------------------------------------------------------
! Pakiet .deb - nazwy, sekcje, zaleznosci
! ---------------------------------------------------------------------------
[package]
-> name             => hackeros-kernel-cybersecurity
-> section          => kernel
-> priority         => optional
-> architecture     => amd64
-> conflicts        => ["linux-image-amd64"]
-> replaces         => ["linux-image-amd64"]
-> provides         => ["linux-image", "linux-image-amd64"]
-> depends          => ["initramfs-tools | dracut", "kmod", "grub-pc | grub-efi-amd64", "openssl"]
-> recommends       => ["xen-hypervisor-4.20-amd64", "hackeros-cybersecurity-tools"]
-> set_default      => true
-> remove_old_kernel => true
-> postinst_grub_update => true

! ---------------------------------------------------------------------------
! Wersjonowanie pakietu .deb
! ---------------------------------------------------------------------------
[versioning]
-> kernel_suffix     => hackeros-cybersec
-> abi_tag           => hk1
-> deb_version       => ${source.base_version}-${versioning.abi_tag}
-> uname_suffix      => -${versioning.kernel_suffix}

! ---------------------------------------------------------------------------
! Konfiguracja kompilacji (.config jadra)
! ---------------------------------------------------------------------------
[build]
-> jobs            => auto
-> compiler        => gcc
-> use_ccache      => true
-> output          => ./dist
-> base_config     => config/base.config
-> fragments_dir   => config/fragments
-> localmodconfig  => false
-> strip_modules   => true
-> build_dir       => ./build
-> log_dir         => ./logs

! ---------------------------------------------------------------------------
! Patche nakladane w kolejnosci (fork patchset HackerOS Cybersecurity)
! ---------------------------------------------------------------------------
[patches]
-> dir          => ./patches
-> apply_order  => [
  "0001-hackeros-branding.patch",
  "0002-hardened-memory-protections.patch",
  "0003-grsecurity-inspired-restrictions.patch",
  "0004-xen-dom0-cybersec-tuning.patch",
  "0005-network-forensics-hooks.patch",
  "0006-syscall-auditing-extended.patch",
  "0007-randomize-kstack-default-on.patch",
  "0008-disable-legacy-debug-interfaces.patch",
  "0009-bpf-jit-harden-default-on.patch",
  "0010-yama-ptrace-scope-default-restricted.patch",
  "0011-tcp-md5-and-syn-flood-hardening.patch",
  "0012-usb-rawgadget-audit-log.patch",
  "0013-module-sig-enforce-tamper-evident.patch",
  "0014-xen-domu-network-isolation-default.patch",
  "0015-ebpf-prog-load-audit-trail.patch",
  "0016-kernel-lockdown-confidentiality-strict.patch"
  ]
-> fail_on_reject => true

! ---------------------------------------------------------------------------
! Hardening / cybersecurity - flagi wysokiego poziomu, mapowane na CONFIG_*
! przez build.lua na fragmenty .config w config/fragments/
! ---------------------------------------------------------------------------
[hardening]
-> kaslr                  => true
-> stack_protector_strong  => true
-> fortify_source          => true
-> randomize_kstack_offset => true
-> slab_freelist_hardened  => true
-> page_table_isolation    => true
-> retpoline                => true
-> lockdown_mode            => confidentiality
-> module_sig                => true
-> module_sig_force          => false
-> bpf_jit_hardening        => true
-> debug_fs                 => false
-> dev_mem                  => false
-> kexec                    => false
-> seccomp                  => true
-> selinux                  => false
-> apparmor                => true
-> audit                    => true
-> integrity_appraisal      => true

! ---------------------------------------------------------------------------
! Runtime hardening - ustawienia ktore NIE sa CONFIG_* w .config, a parametrami
! startowymi jadra (GRUB_CMDLINE) lub sysctl ustawianymi przez postinst.
! Sa stabilne miedzy wersjami jadra (w odroznieniu od patchy zaczepionych
! o konkretne linie kodu), bo to oficjalne, dokumentowane interfejsy ABI.
! ---------------------------------------------------------------------------
[runtime_hardening]
! --- Parametry wiersza polecen jadra (dopisywane do GRUB_CMDLINE_LINUX_DEFAULT) ---
-> boot_params
--> randomize_kstack_offset => on
--> "page_alloc.shuffle"      => 1
--> slab_nomerge               => true
--> init_on_alloc              => 1
--> init_on_free                => 1
--> "usbcore.authorized_default" => 2
--> debugfs                      => off
--> mce                          => 0
--> vsyscall                     => none

! --- Sysctl wymuszane przez postinst do /etc/sysctl.d/99-hackeros-cybersec.conf ---
-> sysctl
--> "kernel.kptr_restrict"             => 2
--> "kernel.dmesg_restrict"             => 1
--> "kernel.yama.ptrace_scope"           => 2
--> "kernel.unprivileged_bpf_disabled"    => 1
--> "net.core.bpf_jit_harden"             => 2
--> "kernel.kexec_load_disabled"          => 1
--> "kernel.sysrq"                          => 0
--> "kernel.perf_event_paranoid"            => 3
--> "net.ipv4.tcp_syncookies"                => 1
--> "net.ipv4.conf.all.rp_filter"             => 1
--> "net.ipv4.conf.all.accept_source_route"    => 0
--> "net.ipv4.icmp_echo_ignore_broadcasts"      => 1
--> "net.ipv4.conf.all.log_martians"             => 1
--> "fs.protected_hardlinks"                       => 1
--> "fs.protected_symlinks"                          => 1
--> "fs.suid_dumpable"                                => 0

! ---------------------------------------------------------------------------
! Wsparcie dla Xen (hypervisor juz obecny w HackerOS Cybersecurity Edition)
! ---------------------------------------------------------------------------
[xen]
-> enabled       => true
-> dom0_support  => true
-> domu_support  => true
-> pv_support    => true
-> hvm_support   => true
-> pci_passthrough => true
-> blkback        => true
-> netback        => true

! ---------------------------------------------------------------------------
! Moduly / podsystemy istotne dla cybersecurity (pentesting, forensics, sniffing)
! ---------------------------------------------------------------------------
[cybersecurity_subsystems]
-> netfilter_full        => true
-> nf_tables              => true
-> packet_socket          => true
-> usb_monitor            => true
-> tcp_md5                => true
-> wireless_injection     => true
-> bluetooth_monitor       => true
-> ebpf_tracing            => true
-> kprobes                 => true
-> ftrace                  => true
-> crypto_user_api         => true
-> dm_crypt                => true
-> dm_verity                => true
-> tpm_support              => true
-> ima_evm                  => true

[paths]
-> src_dir      => ./src
-> kernel_src   => ${paths.src_dir}/linux
-> deb_workdir  => ./debian-build
-> headers_deb_workdir => ./debian-build-headers
-> output_deb   => ${build.output}/${package.name}_${versioning.deb_version}_${package.architecture}.deb
-> output_headers_deb => ${build.output}/${headers_package.name}_${versioning.deb_version}_${package.architecture}.deb

! ---------------------------------------------------------------------------
! Podpisywanie modulow i pakietu. Jesli hardening.module_sig = true,
! build.lua wygeneruje wlasna pare kluczy X.509 (RSA) uzywana do podpisania
! WSZYSTKICH modulow w drzewie (wbudowanych i przyszlych out-of-tree/DKMS),
! zamiast jednorazowego klucza generowanego domyslnie przez sam kernel.
! Klucz prywatny jest zachowywany w keys_dir, aby DKMS mogl podpisywac
! nowo budowane moduly tym samym kluczem po instalacji.
! ---------------------------------------------------------------------------
[signing]
-> sign_modules     => true
-> keys_dir          => ./build/keys
-> key_cn             => HackerOS Kernel Module Signing
-> key_days_valid      => 3650
-> install_key_for_dkms => true
-> sign_package      => false
-> gpg_key_id         => ""

! ---------------------------------------------------------------------------
! Osobny pakiet .deb z naglowkami jadra (linux-headers-*), niezbedny do
! budowania modulow out-of-tree przez DKMS - kluczowe dla edycji cybersecurity,
! gdzie uzytkownicy doinstalowuja sterowniki WiFi do wstrzykiwania pakietow
! (np. rtl88xxau, rtl8812au) ktore nie sa w drzewie glownym jadra.
! ---------------------------------------------------------------------------
[headers_package]
-> enabled       => true
-> name           => hackeros-kernel-headers-cybersecurity
-> depends         => ["gcc", "make", "binutils", "libssl-dev", "bc", "flex", "bison", "libelf-dev"]
-> recommends      => ["dkms"]
-> install_dkms_conf => true

! ===========================================================================
! Koniec config.hk
! ===========================================================================
