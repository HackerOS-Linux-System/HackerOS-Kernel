! ===========================================================================
! HackerOS Kernel - config.hk
! Glowny plik konfiguracyjny build systemu jadra
! Format: .hk (https://hackeros-linux-system.github.io/HackerOS-Website/tools-docs/hk.html)
! ===========================================================================

[metadata]
-> name        => HackerOS Kernel
-> codename    => cybersecurity
-> branch      => cybersecurity
-> maintainer  => HackerOS Linux System <hackeros068@gmail.com>
-> homepage    => https://hackeros-linux-system.github.io/HackerOS-Website/
-> license     => MPL-2.0
-> description => Zmodyfikowane jadro Linux dla HackerOS Cybersecurity Edition
-> edition     => Cybersecurity

! ---------------------------------------------------------------------------
! Zrodlo jadra (vanilla Linux). Build.lua sciaga ten tarball i nadpisuje go
! patchami z patches/. Wersja jadra konfigurowana tutaj - zmien base_version
! aby przestawic na nowsza wersje. Najnowsza stabilna: 7.1
! auto_latest=false: wersja KONTROLOWANA przez ten plik, nie auto-detekcja.
! ---------------------------------------------------------------------------
[source]
-> base_version    => "7.2"
-> auto_latest     => false
-> min_version     => 7.2
-> mirror          => https://cdn.kernel.org/pub/linux/kernel/v${source.major}.x/
-> major           => "7"
-> tarball_pattern => linux-${source.base_version}.tar.xz
-> sha_check       => true

! Aby zmienic wersje jadra, ustaw base_version powyzej i (opcjonalnie) major.
! Przykladowe przyszle wersje:
!   -> base_version => 7.2
!   -> base_version => 7.3

[target]
-> arch         => x86_64
-> distro       => debian
-> distro_base  => testing
-> format       => deb
-> bootloader   => grub2
-> init_systems => ["systemd"]

! ---------------------------------------------------------------------------
! Pakiet .deb - nazwy, sekcje, zaleznosci
! ---------------------------------------------------------------------------
[package]
-> name             => hackeros-kernel-redteam
-> section          => kernel
-> priority         => optional
-> architecture     => amd64
-> conflicts        => ["linux-image-amd64"]
-> replaces         => ["linux-image-amd64"]
-> provides         => ["linux-image", "linux-image-amd64", "hackeros-kernel-cybersecurity"]
-> depends          => ["initramfs-tools | dracut", "kmod", "grub-pc | grub-efi-amd64", "openssl"]
-> recommends       => ["xen-hypervisor-4.20-amd64", "hackeros-redteam-tools", "hackeros-cybersecurity-tools"]
-> set_default      => true
-> remove_old_kernel => true
-> postinst_grub_update => true

! ---------------------------------------------------------------------------
! Wersjonowanie pakietu .deb
! ---------------------------------------------------------------------------
[versioning]
-> kernel_suffix     => hackeros-redteam
-> abi_tag           => hk2
-> deb_version       => ${source.base_version}-${versioning.abi_tag}
-> uname_suffix      => -${versioning.kernel_suffix}

! ---------------------------------------------------------------------------
! Konfiguracja kompilacji (.config jadra)
! PELNY BUILD ze wszystkimi sterownikami - nie minimalistyczny.
! Wlacza: WiFi injection drivers, USB gadget, Bluetooth HCI, full netfilter.
! ---------------------------------------------------------------------------
[build]
-> jobs            => auto
-> compiler        => gcc
-> use_ccache      => true
-> output          => ./dist
-> base_config     => config/base.config
-> fragments_dir   => config/fragments
-> localmodconfig  => false
-> strip_modules   => true
-> build_dir       => ./build
-> log_dir         => ./logs
-> full_drivers    => true
-> no_minimal      => true

! ---------------------------------------------------------------------------
! Patche nakladane w kolejnosci (35 patchy: cybersec + red team + ostree)
! ---------------------------------------------------------------------------
[patches]
-> dir          => ./patches
-> apply_order  => [
  "0001-hackeros-branding.patch",
  "0002-hardened-memory-protections.patch",
  "0003-grsecurity-inspired-restrictions.patch",
  "0004-xen-dom0-cybersec-tuning.patch",
  "0005-network-forensics-hooks.patch",
  "0006-syscall-auditing-extended.patch",
  "0007-randomize-kstack-default-on.patch",
  "0008-disable-legacy-debug-interfaces.patch",
  "0009-bpf-jit-harden-default-on.patch",
  "0010-yama-ptrace-scope-default-restricted.patch",
  "0011-tcp-md5-and-syn-flood-hardening.patch",
  "0012-usb-rawgadget-audit-log.patch",
  "0013-module-sig-enforce-tamper-evident.patch",
  "0014-xen-domu-network-isolation-default.patch",
  "0015-ebpf-prog-load-audit-trail.patch",
  "0016-kernel-lockdown-confidentiality-strict.patch",
  "0017-redteam-branding-redteam-edition.patch",
  "0018-redteam-raw-socket-cap-bypass.patch",
  "0019-redteam-wifi-monitor-injection.patch",
  "0020-redteam-packet-mmap-ring.patch",
  "0021-redteam-netfilter-redteam-hooks.patch",
  "0022-redteam-usb-gadget-hid-emulation.patch",
  "0023-redteam-memory-forensics-ptrace.patch",
  "0024-redteam-kprobes-uprobe-extended.patch",
  "0025-redteam-tun-tap-vpn-red-team.patch",
  "0026-redteam-crypto-user-api-extended.patch",
  "0027-redteam-namespace-isolation-redteam.patch",
  "0028-redteam-bluetooth-monitor-hci.patch",
  "0029-redteam-nfqueue-mitm-extensions.patch",
  "0030-redteam-perf-events-unprivileged.patch",
  "0031-ostree-dm-verity-composefs-integration.patch",
  "0032-ostree-overlayfs-whiteout-ostree.patch",
  "0033-ostree-boot-integrity-verification.patch",
  "0034-ostree-sysfs-deployment-api.patch",
  "0035-redteam-full-driver-build-marker.patch"
  ]
-> fail_on_reject => true

! ---------------------------------------------------------------------------
! Hardening / cybersecurity - flagi wysokiego poziomu
! ---------------------------------------------------------------------------
[hardening]
-> kaslr                  => true
-> stack_protector_strong  => true
-> fortify_source          => true
-> randomize_kstack_offset => true
-> slab_freelist_hardened  => true
-> page_table_isolation    => true
-> retpoline                => true
-> lockdown_mode            => confidentiality
-> module_sig                => true
-> module_sig_force          => false
-> bpf_jit_hardening        => true
-> debug_fs                 => false
-> dev_mem                  => false
-> kexec                    => false
-> seccomp                  => true
-> selinux                  => false
-> apparmor                => true
-> audit                    => true
-> integrity_appraisal      => true

! ---------------------------------------------------------------------------
! Red Team rozszerzenia - konfiguracja ofensywnych mozliwosci
! ---------------------------------------------------------------------------
[redteam]
-> enabled                  => true
-> raw_socket_mode           => 0
-> wifi_monitor_mode         => true
-> wifi_packet_injection     => true
-> bluetooth_monitor         => true
-> bluetooth_raw_hci         => false
-> ble_adv_sniff             => true
-> usb_hid_emulation         => true
-> usb_hid_inject_delay_ms   => 10
-> usb_hid_layout            => 0
-> ptrace_forensics           => true
-> ptrace_redteam_scope       => 0
-> kprobe_redteam_mode        => 0
-> tun_redteam_queues          => 64
-> tun_vxlan_offload           => true
-> crypto_extended_algos       => true
-> namespace_net_recycle       => true
-> perf_redteam_paranoid       => -1
-> nfqueue_redteam_base        => 1024
-> nfqueue_redteam_count       => 1024
-> nfqueue_max_payload          => 65535
-> nfqueue_bypass_ct            => false
-> packet_ring_frames           => 4096

! ---------------------------------------------------------------------------
! OSTree / immutable OS integracja (debian-ostree)
! ---------------------------------------------------------------------------
[ostree]
-> enabled                 => true
-> dm_verity_ostree         => true
-> composefs_support        => true
-> overlayfs_extensions     => true
-> ima_verification         => true
-> ima_enforce              => true
-> sysfs_api                => true
-> deploy_path              => /ostree/deploy
-> repo_path                => /ostree/repo
-> grub_integration         => true
-> atomic_updates           => true
-> rollback_support         => true

! ---------------------------------------------------------------------------
! Runtime hardening - boot params i sysctl
! ---------------------------------------------------------------------------
[runtime_hardening]
-> boot_params
--> randomize_kstack_offset => on
--> "page_alloc.shuffle"      => 1
--> slab_nomerge               => true
--> init_on_alloc              => 1
--> init_on_free                => 1
--> "usbcore.authorized_default" => 2
--> debugfs                      => off
--> mce                          => 0
--> vsyscall                     => none

-> sysctl
--> "kernel.kptr_restrict"             => 2
--> "kernel.dmesg_restrict"             => 1
--> "kernel.yama.ptrace_scope"           => 2
--> "kernel.unprivileged_bpf_disabled"    => 1
--> "net.core.bpf_jit_harden"             => 2
--> "kernel.kexec_load_disabled"          => 1
--> "kernel.sysrq"                          => 0
--> "kernel.perf_event_paranoid"            => 3
--> "net.ipv4.tcp_syncookies"                => 1
--> "net.ipv4.conf.all.rp_filter"             => 1
--> "net.ipv4.conf.all.accept_source_route"    => 0
--> "net.ipv4.icmp_echo_ignore_broadcasts"      => 1
--> "net.ipv4.conf.all.log_martians"             => 1
--> "fs.protected_hardlinks"                       => 1
--> "fs.protected_symlinks"                          => 1
--> "fs.suid_dumpable"                                => 0

! ---------------------------------------------------------------------------
! Wsparcie dla Xen
! ---------------------------------------------------------------------------
[xen]
-> enabled       => true
-> dom0_support  => true
-> domu_support  => true
-> pv_support    => true
-> hvm_support   => true
-> pci_passthrough => true
-> blkback        => true
-> netback        => true

! ---------------------------------------------------------------------------
! Moduly / podsystemy cybersecurity (rozszerzone o red team)
! ---------------------------------------------------------------------------
[cybersecurity_subsystems]
-> netfilter_full        => true
-> nf_tables              => true
-> packet_socket          => true
-> usb_monitor            => true
-> tcp_md5                => true
-> wireless_injection     => true
-> bluetooth_monitor       => true
-> ebpf_tracing            => true
-> kprobes                 => true
-> ftrace                  => true
-> crypto_user_api         => true
-> dm_crypt                => true
-> dm_verity                => true
-> tpm_support              => true
-> ima_evm                  => true
-> usb_gadget_hid           => true
-> tun_tap_advanced         => true
-> nfqueue_mitm             => true
-> raw_socket_extended      => true
-> perf_events_full         => true
-> namespace_full           => true

[paths]
-> src_dir      => ./src
-> kernel_src   => ${paths.src_dir}/linux
-> deb_workdir  => ./debian-build
-> headers_deb_workdir => ./debian-build-headers
-> output_deb   => ${build.output}/${package.name}_${versioning.deb_version}_${package.architecture}.deb
-> output_headers_deb => ${build.output}/${headers_package.name}_${versioning.deb_version}_${package.architecture}.deb

! ---------------------------------------------------------------------------
! Podpisywanie modulow i pakietu
! ---------------------------------------------------------------------------
[signing]
-> sign_modules     => true
-> keys_dir          => ./build/keys
-> key_cn             => HackerOS Red Team Kernel Module Signing
-> key_days_valid      => 3650
-> install_key_for_dkms => true
-> sign_package      => false
-> gpg_key_id         => ""

! ---------------------------------------------------------------------------
! Osobny pakiet .deb z naglowkami jadra
! ---------------------------------------------------------------------------
[headers_package]
-> enabled       => true
-> name           => hackeros-kernel-headers-redteam
-> depends         => ["gcc", "make", "binutils", "libssl-dev", "bc", "flex", "bison", "libelf-dev"]
-> recommends      => ["dkms", "hackeros-redteam-dkms-drivers"]
-> install_dkms_conf => true

! ===========================================================================
! Koniec config.hk
! ===========================================================================
