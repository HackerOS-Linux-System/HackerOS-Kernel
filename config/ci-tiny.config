# =============================================================================
# HackerOS Kernel - config/ci-tiny.config
# =============================================================================
#
# Minimalna konfiguracja bazowa uzywana WYLACZNIE przez CI (--ci-fast w
# build.lua) do szybkiego "czy to sie w ogole kompiluje" smoke-testu.
#
# NIE jest to konfiguracja produkcyjna HackerOS Kernel - nie zawiera
# wiekszosci sterownikow, modulow Xen, ani pelnego zestawu podsystemow
# cybersecurity z config/base.config. Sluzy tylko do zweryfikowania, ze:
#   1) wszystkie 16 patchy HackerOS aplikuja sie I kompiluja bez bledow,
#   2) CONFIG_HACKEROS_KERNEL=y nie psuje budowy na minimalnym .config,
#   3) podstawowe CONFIG_* z [hardening] da sie nalozyc bez konfliktow.
#
# Bazuje na kernel/configs/tiny.config (CC_OPTIMIZE_FOR_SIZE, SLUB_TINY) +
# minimalne dopiski wymagane, by patche 9-16 mialy gdzie sie skompilowac
# (BPF, AUDIT, YAMA, USB, modules - bez tego cale podsystemy ktore patche
# dotykaja byłyby wycięte przez tinyconfig i kod nigdy by się nie skompilowal,
# co dawalo by falszywie pozytywny / nieinformacyjny wynik CI).
# =============================================================================

CONFIG_64BIT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_KERNEL_XZ=y
CONFIG_SLUB=y
CONFIG_SLUB_TINY=y
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y

# Wymagane zeby skompilowac patche 9-16 (BPF, audit, USB, module signing,
# Xen netback, lockdown) - bez tych podsystemow caly kod patcha jest
# wycinany przez #ifdef CONFIG_* na wyzszym poziomie i nie zostalby
# w ogole skompilowany, czyniac test bezwartosciowym.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BPF_SYSCALL=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_PCI=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETFILTER=y

# Minimalny zestaw do zbudowania na x86_64 bez pelnego sprzetu
CONFIG_BLK_DEV_INITRD=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
