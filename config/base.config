# =============================================================================
# HackerOS Kernel - config/base.config
# =============================================================================
#
# To jest BAZOWY punkt startowy dla konfiguracji jadra, scalany przez
# build.lua (modul kconfig.lua) z fragmentami z config/fragments/ oraz
# z auto-generowanym fragmentem hardeningu/Xen/cybersecurity.
#
# W praktyce produkcyjnej zaleca sie wygenerowanie tego pliku przez:
#   cd src/linux && make x86_64_defconfig
#   cp .config ../../config/base.config
# a nastepnie dopisanie/poprawienie ponizszych kluczowych opcji recznie.
#
# Ten plik zawiera jedynie NAJWAZNIEJSZE opcje wysokiego poziomu jako
# punkt odniesienia - merge_config.sh + "make olddefconfig" dopelni
# reszte na podstawie pelnego Kconfig zrodel jadra.
# =============================================================================

CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=256

# --- Podstawowe systemy plikow ---
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y
CONFIG_XFS_FS=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# --- Init / systemd ---
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# --- Sterowniki podstawowe (desktop/server x86_64) ---
CONFIG_PCI=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SCSI=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_WLAN=y
CONFIG_BT=y

# --- Wirtualizacja (KVM jako fallback, Xen wlaczany przez fragment) ---
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y

# --- Siec ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_BRIDGE=y
CONFIG_VLAN_8021Q=y
CONFIG_WIREGUARD=y

# --- Power management ---
CONFIG_PM=y
CONFIG_ACPI=y
CONFIG_CPU_FREQ=y

# --- Modules ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# =============================================================================
# Reszta opcji (hardening, Xen, cybersecurity subsystems) jest dodawana
# automatycznie przez build.lua na podstawie config.hk - nie trzeba ich
# tutaj duplikowac.
# =============================================================================
