CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m
CONFIG_GPIO_SYSFS=y

# Random
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_INTEL=m
