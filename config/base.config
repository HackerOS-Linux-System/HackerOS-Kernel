# =============================================================================
# HackerOS Kernel - config/base.config
# =============================================================================
#
# PELNA konfiguracja produkcyjna - odpowiednik Debian linux-image-amd64.
#
# Strategia budowania:
#   1. kconfig.lua wykonuje "make x86_64_defconfig" w drzewie zrodel
#      (daje ~2500 opcji jak standardowy kernel.org release)
#   2. Nastepnie merge_config.sh scala z tym plikiem (nadpisujemy to co chcemy)
#   3. Nastepnie scala z auto-generowanym fragmentem hardeningu z config.hk
#   4. Na koniec "make olddefconfig" dopelnia brakujace zaleznosci
#
# Ten plik nadpisuje/rozszerza x86_64_defconfig o:
#   - pelny zestaw sterownikow sieciowych, WiFi, Bluetooth, USB
#   - sterowniki wymagane przez red team (raw socket, USB gadget, mac80211)
#   - pelny netfilter/nftables/NFQUEUE
#   - BPF/eBPF pelny zestaw
#   - systemy plikow dla OSTree (overlayfs, dm-verity, composefs)
#   - Xen dom0/domU
#   - pelne wsparcie hardware x86_64 (nie minimalistyczne)
# =============================================================================

# --- Architektura ---
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=512
CONFIG_NUMA=y
CONFIG_X86_INTEL_USERCOPY=y
CONFIG_X86_USE_PPRO_CHECKSUM=y

# --- Kompresja jadra ---
CONFIG_KERNEL_ZSTD=y

